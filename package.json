{
  "name": "construction-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Integrated Construction ERP - program baseline (Part 00)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "erp:tokens": "node scripts/erp-program/generate-tokens.mjs",
    "erp:lint-design": "node scripts/erp-program/lint-design.mjs",
    "erp:db-migrate": "node scripts/erp-program/db_migrate.mjs up",
    "erp:db-rollback": "node scripts/erp-program/db_migrate.mjs down",
    "erp:db-baseline": "node scripts/erp-program/schema_baseline_export.mjs",
    "erp:db-integrity": "node scripts/erp-program/db_integrity_check.mjs",
    "erp:audit": "node scripts/erp-program/audit.mjs",
    "erp:regression": "node scripts/erp-program/regression.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "next": "^14.2.15",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.2"
  }
}
