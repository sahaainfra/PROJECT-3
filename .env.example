# Construction ERP — environment example (copy to .env.local)
# PostgreSQL connection (server-side only; never expose to the client)
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp
# Comma-separated list of flags forced ON regardless of DB state (used by CI / local dev)
ERP_FLAGS_FORCE_ON=ff.pgm
# Runtime environment: local | staging | production
ERP_ENV=local
