# Local development only. Replace every value before use outside a developer machine.
DATABASE_URL="postgresql://erp_dev:local-dev-password-change-before-use@localhost:5432/construction_erp?schema=public"
POSTGRES_USER="erp_dev"
POSTGRES_PASSWORD="local-dev-password-change-before-use"
POSTGRES_DB="construction_erp"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Server-side rollout configuration; omitted flags are disabled.
ERP_FEATURE_FLAGS_JSON="{}"

# Set these only for the one-time first administrator bootstrap.
ERP_BOOTSTRAP_CONFIRM=""
ERP_ADMIN_EMAIL=""
ERP_ADMIN_NAME=""
ERP_ADMIN_PASSWORD=""
ERP_COMPANY_NAME=""
ERP_COMPANY_CODE=""
